<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppCadastroEventos.Views.CadastroEventoPage"
             Title="Cadastro de Eventos"
             BackgroundColor="#F4F4F4">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Cabeçalho Temático -->
            <Border Stroke="#C8102E" StrokeThickness="0" BackgroundColor="#C8102E" StrokeShape="RoundRectangle 10" Padding="15">
                <VerticalStackLayout Spacing="5">
                    <Label Text="🚩 PT - Partido dos Trabalhadores"
                           TextColor="White"
                           FontSize="14"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                    <Label Text="Cadastro de Evento Popular"
                           TextColor="White"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Nome do Evento -->
            <Border Stroke="#DDD" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 8" Padding="10">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Nome do Evento:" FontAttributes="Bold" TextColor="#333" />
                    <Entry x:Name="txt_nome" 
                           Text="Encontro de Formação Política do PT" 
                           Placeholder="Digite o nome do evento..." />
                </VerticalStackLayout>
            </Border>

            <!-- Datas de Início e Término -->
            <Border Stroke="#DDD" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 8" Padding="10">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Período do Evento:" FontAttributes="Bold" TextColor="#333" />

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Data de Início:" FontSize="12" TextColor="#666" />
                            <DatePicker x:Name="dtpck_inicio" Format="dd/MM/yyyy" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Data de Término:" FontSize="12" TextColor="#666" />
                            <DatePicker x:Name="dtpck_termino" Format="dd/MM/yyyy" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Número de Participantes com Stepper -->
            <Border Stroke="#DDD" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 8" Padding="10">
                <VerticalStackLayout Spacing="5">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Número de Participantes:" FontAttributes="Bold" VerticalOptions="Center" TextColor="#333"/>
                        <Label Text="{Binding Source={x:Reference stp_participantes}, Path=Value}" 
                               Grid.Column="1" 
                               FontAttributes="Bold" 
                               FontSize="18" 
                               TextColor="#C8102E" 
                               VerticalOptions="Center"/>
                    </Grid>
                    <Stepper x:Name="stp_participantes" Minimum="1" Maximum="1000" Increment="1" Value="50" HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </Border>

            <!-- Local do Evento -->
            <Border Stroke="#DDD" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 8" Padding="10">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Local do Evento:" FontAttributes="Bold" TextColor="#333" />
                    <Entry x:Name="txt_local" 
                           Text="Sindicato dos Metalúrgicos - São Bernardo do Campo" 
                           Placeholder="Digite o local..." />
                </VerticalStackLayout>
            </Border>

            <!-- Custo por Participante -->
            <Border Stroke="#DDD" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 8" Padding="10">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Custo por Participante (R$):" FontAttributes="Bold" TextColor="#333" />
                    <Entry x:Name="txt_custo" 
                           Keyboard="Numeric" 
                           Text="25.00" 
                           Placeholder="0.00" />
                </VerticalStackLayout>
            </Border>

            <!-- Botão de Cadastro -->
            <Button Text="Cadastrar Evento 🚩" 
                    BackgroundColor="#C8102E" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    FontSize="16"
                    CornerRadius="8"
                    HeightRequest="50"
                    Clicked="Button_Clicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>