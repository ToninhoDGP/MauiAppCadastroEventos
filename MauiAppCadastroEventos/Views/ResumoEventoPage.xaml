<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppCadastroEventos.Views.ResumoEventoPage"
             Title="Resumo do Evento"
             BackgroundColor="#F4F4F4">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Cabeçalho de Sucesso Temático -->
            <Border Stroke="#C8102E" StrokeThickness="0" BackgroundColor="#C8102E" StrokeShape="RoundRectangle 10" Padding="15">
                <VerticalStackLayout Spacing="5">
                    <Label Text="🚩 Evento Cadastrado com Sucesso!"
                           TextColor="White"
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                    <Label Text="Resumo Oficial da Programação"
                           TextColor="White"
                           FontSize="14"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Nome do Evento -->
            <Border Stroke="#DDD" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 8" Padding="12">
                <VerticalStackLayout Spacing="3">
                    <Label Text="Nome do Evento:" FontSize="12" TextColor="#666" FontAttributes="Bold"/>
                    <Label Text="{Binding Nome}" FontSize="18" TextColor="#C8102E" FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Border>

            <!-- Local do Evento -->
            <Border Stroke="#DDD" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 8" Padding="12">
                <VerticalStackLayout Spacing="3">
                    <Label Text="Local:" FontSize="12" TextColor="#666" FontAttributes="Bold"/>
                    <Label Text="{Binding Local}" FontSize="16" TextColor="#333"/>
                </VerticalStackLayout>
            </Border>

            <!-- Período e Duração -->
            <Border Stroke="#DDD" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 8" Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Período e Duração:" FontSize="12" TextColor="#666" FontAttributes="Bold"/>

                    <Grid ColumnDefinitions="*, *">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Início:" FontSize="11" TextColor="#888"/>
                            <Label Text="{Binding DataInicio, StringFormat='{0:dd/MM/yyyy}'}" FontSize="14" TextColor="#333" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Término:" FontSize="11" TextColor="#888"/>
                            <Label Text="{Binding DataTermino, StringFormat='{0:dd/MM/yyyy}'}" FontSize="14" TextColor="#333" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#EEE" Margin="0,5"/>

                    <HorizontalStackLayout Spacing="5">
                        <Label Text="Duração Total:" FontSize="14" TextColor="#333"/>
                        <Label Text="{Binding DuracaoEmDias, StringFormat='{0} dia(s)'}" FontSize="14" TextColor="#C8102E" FontAttributes="Bold"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Participantes e Custos -->
            <Border Stroke="#DDD" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 8" Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Orçamento e Participação:" FontSize="12" TextColor="#666" FontAttributes="Bold"/>

                    <HorizontalStackLayout Spacing="5">
                        <Label Text="Número de Participantes:" FontSize="14" TextColor="#333"/>
                        <Label Text="{Binding NumeroParticipantes}" FontSize="14" TextColor="#333" FontAttributes="Bold"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="5">
                        <Label Text="Custo por Participante:" FontSize="14" TextColor="#333"/>
                        <Label Text="{Binding CustoPorParticipante, StringFormat='{0:C}'}" FontSize="14" TextColor="#333" FontAttributes="Bold"/>
                    </HorizontalStackLayout>

                    <BoxView HeightRequest="1" Color="#EEE" Margin="0,5"/>

                    <HorizontalStackLayout Spacing="5">
                        <Label Text="Custo Total do Evento:" FontSize="16" TextColor="#C8102E" FontAttributes="Bold"/>
                        <Label Text="{Binding CustoTotal, StringFormat='{0:C}'}" FontSize="18" TextColor="#C8102E" FontAttributes="Bold"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>